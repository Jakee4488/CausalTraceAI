# Stage 1: Build dependencies
FROM python:3.12-slim as builder

WORKDIR /build

# Set environment variables for pip
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Proxy-only dependency set: this image ships proxy/ and never src/, so the
# causal stack (dowhy / causal-learn + pandas / scipy / sklearn / statsmodels /
# sympy, ~450 MB) would be dead weight on a latency-sensitive service. That code
# runs in the Agent Engine, deployed separately from src/ via agents-cli.
COPY requirements-proxy.txt .
RUN pip install --no-cache-dir --user -r requirements-proxy.txt

# Stage 2: Build the React UI
# npm ci needs only the lockfile, so this layer caches until deps actually
# change — editing a component doesn't reinstall node_modules.
FROM node:20-slim AS ui-builder

WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

# Stage 3: Runtime
FROM python:3.12-slim

# No apt packages needed: graphviz was only ever a maybe-dependency of
# causal-learn/dowhy, which this image no longer installs. src/causal/
# estimation.py emits GML via networkx precisely to avoid pydot/graphviz.

# Create a non-root user
RUN groupadd -r tracerlensaiuser && useradd -r -g tracerlensaiuser tracerlensaiuser

WORKDIR /app

# Copy installed dependencies from builder
COPY --chown=tracerlensaiuser:tracerlensaiuser --from=builder /root/.local /home/tracerlensaiuser/.local
ENV PATH=/home/tracerlensaiuser/.local/bin:$PATH
ENV PYTHONPATH="/app:${PYTHONPATH:-}"

# Copy the proxy backend, then the built UI it serves. proxy/main.py resolves
# the bundle at ui/dist (see _ui_directory), which is the same path local dev
# and the E2E suite use — one code path, no per-environment special case.
COPY proxy/ /app/proxy/
COPY --from=ui-builder /ui/dist /app/ui/dist

# Set ownership to non-root user
RUN chown -R tracerlensaiuser:tracerlensaiuser /app

# Switch to non-root user
USER tracerlensaiuser

EXPOSE 8080

CMD ["uvicorn", "proxy.main:app", "--host", "0.0.0.0", "--port", "8080"]
